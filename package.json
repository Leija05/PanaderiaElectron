{
  "name": "dulcehorno",
  "productName": "DulceHorno",
  "version": "1.1.1",
  "description": "Punto de Venta Panaderia",
  "main": "src/main.js",
  "scripts": {
    "build:ui": "node scripts/build.js",
    "prestart": "npm run build:ui",
    "start": "electron .",
    "relay": "node server/relay-server.js",
    "build:hub": "node scripts/build-hub.js",
    "hub": "node scripts/start-hub.js",
    "autostart": "node scripts/setup-autostart.js",
    "autostart:disable": "node scripts/setup-autostart.js disable",
    "test": "node tests/runner.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean && npm run build:ui",
    "predist": "npm run clean && npm run build:ui",
    "build": "electron-builder",
    "dist": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.dulcehorno.app",
    "productName": "DulceHorno",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Leija05",
        "repo": "PanaderiaElectron"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "scripts/post-install.bat",
        "to": "scripts/post-install.bat"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "^26.7.0",
    "rimraf": "^5.0.10"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "mysql": "^2.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leija05/PanaderiaElectron.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Leija05/PanaderiaElectron/issues"
  },
  "homepage": "https://github.com/Leija05/PanaderiaElectron#readme"
}