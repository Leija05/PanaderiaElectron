{
  "name": "dulcehorno",
  "productName": "DulceHorno",
  "version": "1.0.3",
  "description": "Punto de Venta Panaderia",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "predist": "npm run clean",
    "build": "electron-builder",
    "dist": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.dulcehorno.app",
    "productName": "DulceHorno",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Leija05",
        "repo": "PanaderiaElectron"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "^26.7.0",
    "rimraf": "^5.0.10"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "mysql": "^2.18.1",
    "sqlite3": "^5.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leija05/PanaderiaElectron.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Leija05/PanaderiaElectron/issues"
  },
  "homepage": "https://github.com/Leija05/PanaderiaElectron#readme"
}
